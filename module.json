{
  "schema": "corral-light.manifest/1",
  "name": "finops",
  "title": "FinOps",
  "version": "0.1.0",
  "core_api": 1,
  "summary": "What your lanes cost, and how much quota is left",
  "collector": {"script": "collector.py", "args": ["snapshot", "--budget", "25"],
                "every_s": 300, "budget_s": 25, "timeout_s": 45},
  "cli": {"script": "cli.py"},
  "doctor": {"script": "cli.py", "args": ["doctor"]},
  "reads": ["claude-projects", "codex-sessions", "gemini-store", "light-feed"],
  "vendor_reports": ["grok-usage"],
  "network": "none"
}
